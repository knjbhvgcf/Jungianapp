# Stripe Payment Link for Your Type in Depth.
# After payment, redirect to: https://jungology.com/type-in-depth?key=YOUR-DEPTH-KEY
# Live values are set on the jungianapp Cloudflare Pages project (Production).
VITE_DOSSIER_CHECKOUT_URL=
VITE_DOSSIER_UNLOCK_KEYS=your-secret-key
VITE_DOSSIER_PRICE=$3

# Stripe Payment Link to see your type after the quiz ($1). Not Type in Depth.
# After payment, redirect to: https://jungology.com/results?key=YOUR-REVEAL-KEY
VITE_REVEAL_CHECKOUT_URL=
VITE_REVEAL_UNLOCK_KEYS=your-reveal-key
VITE_REVEAL_PRICE=$1

# Compatibility is paused (COMPATIBILITY_OFFERED = false in src/lib/unlock.ts).
# Stripe Payment Link for Compatibility. Separate product, separate key.
# After payment, redirect to: https://jungology.com/compatibility?key=YOUR-COMPAT-KEY
VITE_COMPAT_CHECKOUT_URL=
VITE_COMPAT_UNLOCK_KEYS=your-compat-key
VITE_COMPAT_PRICE=$1


# Cloudflare Web Analytics token — free. Leave empty to disable.
# Dashboard: Analytics & Logs → Web Analytics → Add a site.
VITE_CF_BEACON_TOKEN=

# Google Analytics 4 Measurement ID. Page views plus Stripe begin_checkout / purchase. Quiz answers are not sent.
# The app also falls back to this public ID if the env var is unset at build time.
VITE_GA_MEASUREMENT_ID=G-KPPV97KWXN

# Jungology App subscription ($10 USD/month). Production build needs this set to true.
# VITE_WORKSPACE_OFFERED=true
# After payment, redirect to:
# https://jungology.com/workspace?checkout=success&session_id={CHECKOUT_SESSION_ID}
# Local: http://127.0.0.1:5173/workspace?checkout=success&session_id={CHECKOUT_SESSION_ID}
# A success URL without a Checkout Session id does not mark the account subscribed.
# Customer portal: Settings → Billing → Customer portal → copy the login link.
VITE_WORKSPACE_CHECKOUT_URL=https://buy.stripe.com/6oUfZj4ZdeA3crQeTMeIw03
VITE_WORKSPACE_PORTAL_URL=
VITE_WORKSPACE_PRICE=$10 USD

# Server-only Stripe Checkout for Jungology App. Never prefix these with VITE_.
# Local `npm run dev` reads them from .env. Cloudflare Pages → Settings → Environment variables.
STRIPE_SECRET_KEY=
STRIPE_WORKSPACE_PRICE_ID=
# Stripe Dashboard → Developers → Webhooks → Add endpoint
# URL: https://jungology.com/api/workspace-stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# Then paste the signing secret (whsec_...) here and on Cloudflare Pages.
STRIPE_WEBHOOK_SECRET=

# Password for /admin. Not prefixed with VITE_, so it stays off the public bundle.
# If this is empty, local `npm run dev` accepts "jung".
# The type census at /admin uses this same password. On the live site, also bind a
# Cloudflare KV namespace named TYPE_CENSUS (Pages → Settings → Functions).
ADMIN_PASSWORD=

# Jungology App accounts. Local `npm run dev` works with none of these:
# houses live in .data/workspace-kv.json, and Join shows the sign-in link
# (also printed in the terminal). The public site never shows that link.
# SESSION_SECRET is required on Cloudflare Pages. Local `npm run dev` can omit it.
# SESSION_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Jungology <hello@jungology.com>
# On Cloudflare Pages: bind KV namespace WORKSPACE_HOUSES and set RESEND_API_KEY
# (Resend free tier). Verify jungology.com so mail can come from hello@jungology.com.
