# Stripe Payment Link for Your Type in Depth.
# After payment, redirect to: https://jungology.com/type-in-depth?key=YOUR-DEPTH-KEY
# Live values are set on the jungianapp Cloudflare Pages project (Production).
VITE_DOSSIER_CHECKOUT_URL=
VITE_DOSSIER_UNLOCK_KEYS=your-secret-key
VITE_DOSSIER_PRICE=$3

# Stripe Payment Link for Compatibility. Separate product, separate key.
# After payment, redirect to: https://jungology.com/compatibility?key=YOUR-COMPAT-KEY
VITE_COMPAT_CHECKOUT_URL=
VITE_COMPAT_UNLOCK_KEYS=your-compat-key
VITE_COMPAT_PRICE=$1

# Cloudflare Web Analytics token — free. Leave empty to disable.
# Dashboard: Analytics & Logs → Web Analytics → Add a site.
VITE_CF_BEACON_TOKEN=

# Google Analytics 4 Measurement ID. Page views only; quiz answers are not sent.
# The app also falls back to this public ID if the env var is unset at build time.
VITE_GA_MEASUREMENT_ID=G-KPPV97KWXN

# Password for /admin. Not prefixed with VITE_, so it stays off the public bundle.
# If this is empty, local `npm run dev` accepts "jung".
ADMIN_PASSWORD=
