VITE_DOSSIER_CHECKOUT_URL=
VITE_DOSSIER_UNLOCK_KEYS=your-secret-key
VITE_DOSSIER_PRICE=$3

VITE_COMPAT_CHECKOUT_URL=
VITE_COMPAT_UNLOCK_KEYS=your-compat-key
VITE_COMPAT_PRICE=$1

# Cloudflare Web Analytics token — free. Leave empty to disable.
# Dashboard: Analytics & Logs → Web Analytics → Add a site.
VITE_CF_BEACON_TOKEN=

# Password for /admin. Not prefixed with VITE_, so it stays off the public bundle.
# If this is empty, local `npm run dev` accepts "jung".
ADMIN_PASSWORD=
